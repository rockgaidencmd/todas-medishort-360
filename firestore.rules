// ═══════════════════════════════════════════════════════════════
//  REGLAS DE SEGURIDAD DE FIRESTORE · MEDISHORT360
//
//  Publicar en: console.firebase.google.com → medishort360-f6f20
//               → Firestore Database → pestaña "Reglas" → Publicar
//
//  El proyecto tiene varias colecciones de códigos, una por app
//  (codigos_maestra, codigos_aspa, codigos_uci, codigos_x3…), así que
//  la regla se aplica a todas por igual y no hace falta tocarla al
//  añadir una app nueva.
//
//  QUÉ ARREGLA
//  La regla anterior era "allow read: if true", que permite leer una
//  colección ENTERA. Con la apiKey de las apps (pública por diseño,
//  visible en el código de cualquier web) cualquiera podía descargar
//  la lista completa de códigos con su estado. Ahora se puede
//  consultar un código concreto —hay que saberlo— pero no listarlos.
// ═══════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{coleccion}/{codigoId} {

      // Consultar UN código concreto: sí. Listar la colección: NO.
      // Esta es la línea que cierra el agujero.
      allow get: if true;
      allow list: if false;

      // Estrenar un código libre: una sola vez, y solo puede tocar
      // esos tres campos. Un código ya entregado no se puede reasignar.
      allow update: if
           resource.data.get('estado', 'DISPONIBLE') == 'DISPONIBLE'
        && resource.data.get('dispositivo_id', '') == ''
        && request.resource.data.estado == 'USADO'
        && request.resource.data.dispositivo_id is string
        && request.resource.data.dispositivo_id.size() > 3
        && request.resource.data.dispositivo_id.size() < 64
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'dispositivo_id', 'fecha_activacion']);

      // Crear y borrar códigos: solo desde la consola de Firebase.
      allow create, delete: if false;
    }
  }
}
